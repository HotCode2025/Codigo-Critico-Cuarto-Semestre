# ============================================================
#  Clase 04 - Parte 6 -> Credenciales de Mercado Pago
# ============================================================
#  1. Entrá a https://www.mercadopago.com.ar/developers/panel
#  2. Creá una aplicación -> pestaña "Credenciales de prueba"
#  3. Copiá el Access Token y la Public Key de PRUEBA (empiezan con TEST-)
#  4. Copiá este archivo como  .env  y pegá tus valores
#
#  NUNCA subas el archivo .env al repositorio.
# ============================================================

MP_ACCESS_TOKEN=TEST-TU_ACCESS_TOKEN_DE_PRUEBA
MP_PUBLIC_KEY=TEST-TU_PUBLIC_KEY_DE_PRUEBA

# Puerto del servidor (opcional)
PORT=3000

# URL pública del sitio para las back_urls (opcional en local)
PUBLIC_URL=http://localhost:3000
