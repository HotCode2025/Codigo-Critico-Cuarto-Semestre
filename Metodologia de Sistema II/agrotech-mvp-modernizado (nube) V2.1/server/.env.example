PORT=3000
DATABASE_URL=postgres://usuario:password@host:5432/agrotech
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
CORS_ORIGIN=http://localhost:8000

# Recuperación de contraseña
FRONTEND_URL=http://localhost:8000
N8N_SYSTEM_WEBHOOK_URL=https://tu-instancia.n8n.cloud/webhook/agrotech-recuperar-password

# Si está seteada, todo productor nuevo se registra con N8N habilitado
# automáticamente usando esta URL (sin tener que activarlo a mano en Más > Configuración)
N8N_DEFAULT_WEBHOOK_URL=https://tu-instancia.n8n.cloud/webhook/agrotech-unificado

# Escaneo de facturas con IA (Claude). Se saca en console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
