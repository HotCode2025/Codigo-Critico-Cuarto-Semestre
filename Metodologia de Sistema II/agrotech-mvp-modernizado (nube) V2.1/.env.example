# Variables opcionales para docker-compose. Copiá este archivo como .env (no se sube al repo).
# Sin ellas todo levanta igual: solo no funcionan la IA ni los avisos por N8N.

# Lectura de facturas y diagnóstico de plagas con Claude (console.anthropic.com)
ANTHROPIC_API_KEY=

# Webhooks de N8N. Con el N8N de docker-compose, desde la API se llega como http://n8n:5678/...
# Ej.: http://n8n:5678/webhook/agrotech-unificado
N8N_DEFAULT_WEBHOOK_URL=
N8N_SYSTEM_WEBHOOK_URL=

# Puerto del N8N de docker-compose en tu PC (cambialo si ya usás el 5678 para otro N8N)
N8N_PORT=5678

# Para desarrollo alcanza con el valor por defecto; cambialo si exponés la API fuera de tu PC.
JWT_SECRET=
